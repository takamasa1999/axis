# ローカル開発用の設定例。`cp .env.example .env.local` して使う。
# 本番では Secrets Manager / ECS タスク定義から渡す（plan.md「環境変数」）。

# --- アプリ ---
APP_URL=http://localhost:3000

# --- データベース（docker compose の postgres） ---
DATABASE_URL=postgresql://axis:axis@localhost:5432/axis
# 結合テスト・契約テスト用（docker/postgres/init で作成される）
TEST_DATABASE_URL=postgresql://axis:axis@localhost:5432/axis_test

# --- 認証（Better Auth） ---
# ローカル用の値。本番では `openssl rand -base64 32` で生成した値を Secrets Manager に置く
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef

# --- AI ---
# mock | openrouter | anthropic | bedrock（mock なら API キーなしで動く）
# ローカル開発では openrouter、本番では bedrock を使う
AI_PROVIDER=mock
# openrouter なら例: anthropic/claude-sonnet-5.5 / bedrock なら Bedrock のモデル ID
AI_MODEL_ID=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=ap-northeast-1

# --- STAFF の二要素認証 ---
# 本番では必ず true（false にすると起動しない）。ローカルで手早く確認するときだけ false にできる
REQUIRE_STAFF_2FA=true

# --- メール ---
# smtp（Mailpit） | ses
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Axis <no-reply@axis.local>"

# --- 開発用シード（prisma/seed.ts）。本番では使わない ---
SEED_STAFF_PASSWORD=axis-dev-password
