// Axis Phase1 データモデル
// 正: specs/001-phase1-career-dialogue/data-model.md
//
// 領域A（本人の Axis）… 本人だけが読める
// 領域B（共有）       … 本人が許可した時点のコピー（スナップショット）だけを CA が読める
// 領域C（紹介会社・運営）
//
// ID は UUID v7、日時は UTC（timestamptz）で保存する。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 認証（Better Auth が使うテーブル。User は領域A・C 共通の利用者）
// Session / Account / Verification / TwoFactor の id は、Better Auth が UUID 以外の値で
// 検索することがあるため文字列型にする（User の id は UUID のまま）
// ============================================================

enum UserKind {
  PERSON // 本人（掲示板では求職者）
  EMPLOYER // 企業（求人を出す人）
  STAFF // 運営・001 の紹介会社の所属者
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  // Better Auth の必須項目。本人の表示名（displayName）として使う
  name             String    @default("")
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean?  @default(false)
  kind             UserKind  @default(PERSON)
  isOperator       Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  // ---- 002 掲示板 ----
  /// 連続したログイン失敗の回数（FR-004）
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(3)
  /// 運営による利用停止（FR-035）
  suspendedAt      DateTime? @db.Timestamptz(3)
  suspendedReason  String?
  notifyMessages   Boolean   @default(true)
  notifyJobAlerts  Boolean   @default(true)
  /// 同意した利用規約の版と日時（FR-046）
  termsVersion     String?
  termsAcceptedAt  DateTime? @db.Timestamptz(3)
  /// 求職者が18歳以上であることを確認した日時
  ageConfirmedAt   DateTime? @db.Timestamptz(3)

  sessions     Session[]
  accounts     Account[]
  twoFactors   TwoFactor[]
  personalAxis PersonalAxis?
  memberships  AgencyMember[]
  auditEvents  AuditEvent[]

  employerProfile       EmployerProfile?
  seekerProfile         SeekerProfile?
  jobPosts              JobPost[]
  applications          Application[]
  seekerPosts           SeekerPost[]
  seekerConversations   Conversation[]       @relation("ConversationSeeker")
  employerConversations Conversation[]       @relation("ConversationEmployer")
  messagesSent          Message[]
  blocksMade            Block[]              @relation("BlockBlocker")
  blocksReceived        Block[]              @relation("BlockBlocked")
  reports               Report[]
  moderationActions     ModerationAction[]
  inquiries             Inquiry[]
  savedSearches         SavedSearch[]
  entitlements          FeatureEntitlement[] @relation("EntitlementUser")
  entitlementsGranted   FeatureEntitlement[] @relation("EntitlementGrantedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7))
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7))
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @default(uuid(7))
  userId                  String    @db.Uuid
  secret                  String
  backupCodes             String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// ============================================================
// 領域A: 本人の Axis（読めるのは本人だけ）
// ============================================================

/// 本人の記録全体。紹介会社への外部キーを持たない（原則V）
model PersonalAxis {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    Milestone[]
  relationships AgencyRelationship[]
  auditEvents   AuditEvent[]

  @@map("personal_axes")
}

/// 節目（FR-012）: 就職・転職・昇進/異動・学び直し・人生の変化
enum MilestoneKind {
  JOB_SEARCH
  CAREER_CHANGE
  PROMOTION_TRANSFER
  RESKILLING
  LIFE_EVENT
}

model Milestone {
  id        String        @id @default(uuid(7)) @db.Uuid
  axisId    String        @db.Uuid
  kind      MilestoneKind
  title     String?
  startedAt DateTime      @default(now()) @db.Timestamptz(3)

  axis            PersonalAxis      @relation(fields: [axisId], references: [id], onDelete: Cascade)
  sessions        DialogueSession[]
  recordEntries   RecordEntry[]
  decisionRecords DecisionRecord[]

  @@index([axisId, startedAt])
  @@map("milestones")
}

enum DialogueSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  SAFETY_STOPPED
}

/// Phase1 は TEXT のみ（FR-008）。VOICE は後から追加する
enum DialogueModality {
  TEXT
  VOICE
}

model DialogueSession {
  id              String                @id @default(uuid(7)) @db.Uuid
  milestoneId     String                @db.Uuid
  status          DialogueSessionStatus @default(NOT_STARTED)
  modality        DialogueModality      @default(TEXT)
  startedAt       DateTime?             @db.Timestamptz(3)
  lastActiveAt    DateTime?             @db.Timestamptz(3)
  completedAt     DateTime?             @db.Timestamptz(3)
  safetyStoppedAt DateTime?             @db.Timestamptz(3)

  milestone     Milestone          @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  messages      DialogueMessage[]
  reflection    ReflectionSummary?
  recordEntries RecordEntry[]

  @@index([milestoneId])
  @@map("dialogue_sessions")
}

enum MessageRole {
  PERSON
  AXIS
}

/// AXIS の応答は QUESTION / MATERIAL / SAFETY / INTRO に限る（原則II）
enum MessageKind {
  ANSWER
  QUESTION
  MATERIAL
  SAFETY
  INTRO
}

/// 対話の本文。共有されない。CA 側から読む経路は存在しない（FR-024）
model DialogueMessage {
  id        String      @id @default(uuid(7)) @db.Uuid
  sessionId String      @db.Uuid
  role      MessageRole
  kind      MessageKind
  /// 最大 4,000 文字（本人の発言）。検証はアプリ側（Zod）で行う
  content   String
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  session DialogueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("dialogue_messages")
}

/// 整理結果。1セッションにつき1つ。修正のたびに版を作る（FR-016, FR-021）
model ReflectionSummary {
  id               String  @id @default(uuid(7)) @db.Uuid
  sessionId        String  @unique @db.Uuid
  currentVersionId String? @unique @db.Uuid

  session        DialogueSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  currentVersion ReflectionVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       ReflectionVersion[] @relation("SummaryVersions")

  @@map("reflection_summaries")
}

enum ReflectionAuthor {
  AI
  PERSON
}

model ReflectionVersion {
  id        String           @id @default(uuid(7)) @db.Uuid
  summaryId String           @db.Uuid
  /// 1 から順に増える
  versionNo Int
  createdBy ReflectionAuthor
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  summary   ReflectionSummary   @relation("SummaryVersions", fields: [summaryId], references: [id], onDelete: Cascade)
  currentOf ReflectionSummary?  @relation("CurrentVersion")
  sections  ReflectionSection[]
  consents  SharingConsent[]

  @@unique([summaryId, versionNo])
  @@map("reflection_versions")
}

/// FR-003 の4観点
enum ReflectionAspect {
  FEELINGS // 感情・違和感
  MOTIVATION // 転職したい理由／実現したい状態
  CRITERIA // 判断軸／譲れること・譲れないこと
  OPEN_QUESTIONS // まだ分からないこと／CAと考えたいこと
}

model ReflectionSection {
  id          String           @id @default(uuid(7)) @db.Uuid
  versionId   String           @db.Uuid
  aspect      ReflectionAspect
  content     String
  /// 機微情報の可能性。共有の候補では既定で選ばない（FR-023）
  isSensitive Boolean          @default(false)

  version ReflectionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, aspect])
  @@map("reflection_sections")
}

/// Phase1 の記録項目（FR-010）。⑥〜⑧は値を足すだけで追加できる
enum RecordEntryType {
  VALUES // ①その時点の価値観
  CONCERNS // ②悩み・違和感
  CRITERIA_VISION // ③判断軸・将来像
  OPTIONS_COMPARED // ④比較した選択肢
  REASON // ⑤なぜ選んだか
}

enum RecordSource {
  DIALOGUE
  PERSON
}

model RecordEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  milestoneId     String          @db.Uuid
  type            RecordEntryType
  content         String
  source          RecordSource
  sourceSessionId String?         @db.Uuid
  recordedAt      DateTime        @default(now()) @db.Timestamptz(3)

  milestone     Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  sourceSession DialogueSession? @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)

  @@index([milestoneId, recordedAt])
  @@map("record_entries")
}

/// STAY（今は転職しない）も他の選択と同じ扱い（FR-005）
enum Decision {
  APPLY
  DECLINE
  ACCEPT_OFFER
  STAY
  OTHER
}

model DecisionRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  milestoneId String   @db.Uuid
  decision    Decision
  reason      String
  decidedAt   DateTime @default(now()) @db.Timestamptz(3)
  outcome     String?

  milestone Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  options   DecisionOption[]

  @@index([milestoneId, decidedAt])
  @@map("decision_records")
}

model DecisionOption {
  id              String  @id @default(uuid(7)) @db.Uuid
  decisionId      String  @db.Uuid
  label           String
  /// 本人の判断軸ごとのメモ（{ [criterion: string]: string }）
  notesByCriteria Json    @default("{}")
  chosen          Boolean @default(false)

  decision DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@map("decision_options")
}

// ============================================================
// 領域B: 共有（許可した時点でコピーする）
// ============================================================

enum RelationshipStatus {
  INVITED
  ACTIVE
  ENDED
}

enum RelationshipEndedBy {
  PERSON
  AGENCY
}

/// 本人と紹介会社の関係。本人の Axis の外側に置く（FR-030）
model AgencyRelationship {
  id           String               @id @default(uuid(7)) @db.Uuid
  axisId       String               @db.Uuid
  agencyId     String               @db.Uuid
  assignedCaId String?              @db.Uuid
  invitationId String               @unique @db.Uuid
  status       RelationshipStatus   @default(INVITED)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  endedAt      DateTime?            @db.Timestamptz(3)
  endedBy      RelationshipEndedBy?

  axis       PersonalAxis     @relation(fields: [axisId], references: [id], onDelete: Cascade)
  agency     Agency           @relation(fields: [agencyId], references: [id])
  assignedCa AgencyMember?    @relation(fields: [assignedCaId], references: [id], onDelete: SetNull)
  invitation Invitation       @relation(fields: [invitationId], references: [id])
  consents   SharingConsent[]

  @@unique([axisId, agencyId])
  @@index([agencyId, status])
  @@index([assignedCaId])
  @@map("agency_relationships")
}

/// 共有許可。1つの関係につき「有効な許可」（revokedAt IS NULL AND supersededAt IS NULL）は最大1つ
/// 再許可のときは、古い許可に supersededAt を入れてから、新しい許可を supersedesId 付きで作る
model SharingConsent {
  id                  String    @id @default(uuid(7)) @db.Uuid
  relationshipId      String    @db.Uuid
  reflectionVersionId String    @db.Uuid
  grantedAt           DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt           DateTime? @db.Timestamptz(3)
  supersededAt        DateTime? @db.Timestamptz(3)
  supersedesId        String?   @unique @db.Uuid

  relationship      AgencyRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  reflectionVersion ReflectionVersion  @relation(fields: [reflectionVersionId], references: [id], onDelete: Cascade)
  supersedes        SharingConsent?    @relation("ConsentSupersede", fields: [supersedesId], references: [id])
  supersededBy      SharingConsent?    @relation("ConsentSupersede")
  snapshot          SharedSnapshot?

  @@index([relationshipId])
  @@map("sharing_consents")
}

/// CA が読めるのはこのテーブル（と items）だけ（research R6）
model SharedSnapshot {
  id        String   @id @default(uuid(7)) @db.Uuid
  consentId String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  consent SharingConsent       @relation(fields: [consentId], references: [id], onDelete: Cascade)
  items   SharedSnapshotItem[]

  @@map("shared_snapshots")
}

enum SnapshotSourceKind {
  REFLECTION_SECTION
  RECORD_ENTRY
  DECISION
}

model SharedSnapshotItem {
  id         String             @id @default(uuid(7)) @db.Uuid
  snapshotId String             @db.Uuid
  sourceKind SnapshotSourceKind
  label      String
  content    String
  order      Int

  snapshot SharedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, order])
  @@map("shared_snapshot_items")
}

// ============================================================
// 領域C: 紹介会社・運営
// ============================================================

/// 導入ステップ（共同検証→有償検証→本契約）。Phase1 に課金機能はない
enum AgencyStatus {
  PILOT
  PAID_PILOT
  CONTRACTED
  ENDED
}

model Agency {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  status    AgencyStatus @default(PILOT)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  members       AgencyMember[]
  invitations   Invitation[]
  relationships AgencyRelationship[]
  auditEvents   AuditEvent[]

  @@map("agencies")
}

enum AgencyRole {
  CA
  ADMIN
}

model AgencyMember {
  id       String     @id @default(uuid(7)) @db.Uuid
  agencyId String     @db.Uuid
  userId   String     @db.Uuid
  role     AgencyRole
  active   Boolean    @default(true)

  agency              Agency               @relation(fields: [agencyId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  createdInvitations  Invitation[]         @relation("InvitationCreatedBy")
  assignedInvitations Invitation[]         @relation("InvitationAssignedCa")
  assignedSeekers     AgencyRelationship[]

  @@unique([agencyId, userId])
  @@map("agency_members")
}

/// 利用案内。有効期限は14日。email は受け入れ後に消す
model Invitation {
  id                String    @id @default(uuid(7)) @db.Uuid
  agencyId          String    @db.Uuid
  createdByMemberId String    @db.Uuid
  assignedCaId      String?   @db.Uuid
  email             String?
  tokenHash         String    @unique
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  acceptedAt        DateTime? @db.Timestamptz(3)

  agency       Agency              @relation(fields: [agencyId], references: [id])
  createdBy    AgencyMember        @relation("InvitationCreatedBy", fields: [createdByMemberId], references: [id])
  assignedCa   AgencyMember?       @relation("InvitationAssignedCa", fields: [assignedCaId], references: [id], onDelete: SetNull)
  relationship AgencyRelationship?

  @@index([agencyId, createdAt])
  @@map("invitations")
}

enum AuditEventType {
  INVITATION_SENT
  INVITATION_ACCEPTED
  SESSION_STARTED
  SESSION_COMPLETED
  SESSION_SAFETY_STOPPED
  CONSENT_GRANTED
  CONSENT_REVOKED
  CONSENT_SUPERSEDED
  SNAPSHOT_VIEWED
  SNAPSHOT_EXPORTED
  RELATIONSHIP_ENDED
  AXIS_EXPORTED
  AXIS_DELETED
  // ---- 002 掲示板 ----
  ACCOUNT_CREATED
  ACCOUNT_LOCKED
  ACCOUNT_DELETED
  JOB_PUBLISHED
  JOB_UPDATED
  JOB_CLOSED
  JOB_EXPIRED
  APPLICATION_CREATED
  SEEKER_POST_PUBLISHED
  SEEKER_POST_UNPUBLISHED
  REPORT_CREATED
  MODERATION_ACTION
  INQUIRY_CREATED
  ENTITLEMENT_GRANTED
  RATE_LIMITED
}

/// 操作履歴（追記のみ）。metadata に本文を入れない（ID・件数・版番号のみ）
/// 本人の退会時は actorUserId / axisId を NULL にして匿名の件数として残す
model AuditEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime       @default(now()) @db.Timestamptz(3)
  actorUserId String?        @db.Uuid
  axisId      String?        @db.Uuid
  agencyId    String?        @db.Uuid
  type        AuditEventType
  metadata    Json           @default("{}")

  actor  User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  axis   PersonalAxis? @relation(fields: [axisId], references: [id], onDelete: SetNull)
  agency Agency?       @relation(fields: [agencyId], references: [id])

  @@index([axisId, occurredAt])
  @@index([agencyId, type, occurredAt])
  @@map("audit_events")
}

// ============================================================
// 002 掲示板（specs/002-job-board/data-model.md）
// 職種・都道府県はマスターデータ（src/lib/master-data.ts）の値を文字列で持ち、アプリ側で検証する
// ============================================================

model EmployerProfile {
  id                  String   @id @default(uuid(7)) @db.Uuid
  userId              String   @unique @db.Uuid
  /// 求人の「募集する企業の名称」として表示する [法]
  companyName         String
  prefecture          String
  address             String
  businessDescription String
  contactName         String?
  websiteUrl          String?
  /// 法人番号（任意。13桁）
  corporateNumber     String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "employer_profiles_company_trgm_idx")
  @@map("employer_profiles")
}

model SeekerProfile {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @unique @db.Uuid
  displayName        String
  desiredCategories  String[] @default([])
  desiredPrefectures String[] @default([])
  experience         String?
  qualifications     String?
  selfIntroduction   String?
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seeker_profiles")
}

enum JobPostStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
  HIDDEN // 運営による非公開
}

/// 雇用形態（FR-010）。業務委託など雇用でない募集は載せない
enum EmploymentType {
  FULL_TIME
  CONTRACT
  PART_TIME
  DISPATCH
}

enum ContractType {
  INDEFINITE
  FIXED_TERM
}

enum RenewalPolicy {
  RENEWABLE
  CONDITIONAL
  NOT_RENEWABLE
}

enum RemoteWork {
  NONE
  PARTIAL
  FULL
}

enum Overtime {
  NONE
  EXISTS
}

enum SalaryType {
  HOURLY
  DAILY
  MONTHLY
  ANNUAL
}

enum SmokingMeasure {
  NO_SMOKING_INDOOR
  SMOKING_ROOM
  NO_MEASURE
  OTHER
}

enum AgeExceptionReason {
  RETIREMENT_AGE
  LEGAL_RESTRICTION
  YOUTH_CAREER
  SKILL_SUCCESSION
  ARTS
  SENIOR_PROMOTION
}

/// 求人。[法] は職業安定法第5条の3などで明示が必要な項目（下書きの間は空でもよい）
model JobPost {
  id                    String              @id @default(uuid(7)) @db.Uuid
  employerId            String              @db.Uuid
  status                JobPostStatus       @default(DRAFT)
  title                 String              @default("")
  category              String?
  employmentType        EmploymentType?
  jobDescription        String? /// [法] 業務内容
  jobChangeScope        String? /// [法] 業務内容の変更の範囲
  contractType          ContractType? /// [法]
  contractTermText      String? /// [法] 有期なら必須
  renewalPolicy         RenewalPolicy? /// [法] 有期なら必須
  renewalCapText        String? /// [法] 有期なら必須
  trialPeriodText       String? /// [法]
  prefecture            String? /// [法] 就業場所
  city                  String?
  addressDetail         String?
  remoteWork            RemoteWork          @default(NONE)
  locationChangeScope   String? /// [法] 就業場所の変更の範囲
  workHoursText         String? /// [法]
  overtime              Overtime? /// [法]
  overtimeText          String?
  breakText             String? /// [法]
  holidaysText          String? /// [法]
  salaryType            SalaryType? /// [法]
  salaryMin             Int? /// [法] 円
  salaryMax             Int?
  salaryNote            String?
  fixedOvertimePay      Boolean             @default(false)
  insurance             String[]            @default([]) /// [法]
  smokingMeasure        SmokingMeasure? /// [法]
  smokingText           String?
  ageMin                Int?
  ageMax                Int?
  ageExceptionReason    AgeExceptionReason? /// [法] 年齢の条件を入れるなら必須
  complianceConfirmedAt DateTime?           @db.Timestamptz(3)
  version               Int                 @default(0)
  publishedAt           DateTime?           @db.Timestamptz(3) /// [法] 掲載日
  contentUpdatedAt      DateTime?           @db.Timestamptz(3) /// [法] 最終更新日
  expiresAt             DateTime?           @db.Timestamptz(3) /// [法] 掲載期限（最長60日）
  closedAt              DateTime?           @db.Timestamptz(3)
  hiddenAt              DateTime?           @db.Timestamptz(3)
  hiddenReason          String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  employer      User              @relation(fields: [employerId], references: [id], onDelete: Cascade)
  revisions     JobPostRevision[]
  applications  Application[]
  conversations Conversation[]

  @@index([status, expiresAt])
  @@index([status, publishedAt])
  @@index([employerId, status])
  // キーワード検索用（research R4。pg_trgm 拡張はマイグレーションで有効化）
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_posts_title_trgm_idx")
  @@index([jobDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "job_posts_description_trgm_idx")
  @@map("job_posts")
}

model JobPostRevision {
  id            String   @id @default(uuid(7)) @db.Uuid
  jobPostId     String   @db.Uuid
  version       Int
  snapshot      Json
  /// 前の版から変わった項目（労働条件の変更の通知に使う、FR-015）
  changedFields String[] @default([])
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, version])
  @@map("job_post_revisions")
}

model Application {
  id             String   @id @default(uuid(7)) @db.Uuid
  jobPostId      String   @db.Uuid
  seekerId       String   @db.Uuid
  conversationId String   @db.Uuid
  /// 求職者が共有を選んだプロフィールの項目（FR-022）
  sharedFields   String[] @default([])
  /// 応募した時点で共有した内容のコピー。企業が見るのはこれ（FR-023）
  sharedProfile  Json
  jobVersion     Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  jobPost      JobPost      @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  seeker       User         @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, seekerId])
  @@index([seekerId])
  @@map("applications")
}

enum SeekerPostStatus {
  PUBLISHED
  UNPUBLISHED
  HIDDEN // 運営による非公開
}

model SeekerPost {
  id                String           @id @default(uuid(7)) @db.Uuid
  seekerId          String           @db.Uuid
  title             String
  body              String
  desiredCategory   String?
  desiredPrefecture String?
  employmentTypes   EmploymentType[] @default([])
  status            SeekerPostStatus @default(UNPUBLISHED)
  publishedAt       DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  seeker        User           @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([status, publishedAt])
  @@map("seeker_posts")
}

enum ConversationOrigin {
  APPLICATION
  INQUIRY
  EMPLOYER_CONTACT
}

/// 求職者と企業の1対1の会話。同じ組み合わせは1つにまとめる
model Conversation {
  id                 String             @id @default(uuid(7)) @db.Uuid
  seekerId           String             @db.Uuid
  employerId         String             @db.Uuid
  origin             ConversationOrigin
  jobPostId          String?            @db.Uuid
  seekerPostId       String?            @db.Uuid
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  lastMessageAt      DateTime           @default(now()) @db.Timestamptz(3)
  seekerLastReadAt   DateTime?          @db.Timestamptz(3)
  employerLastReadAt DateTime?          @db.Timestamptz(3)

  seeker       User          @relation("ConversationSeeker", fields: [seekerId], references: [id], onDelete: Cascade)
  employer     User          @relation("ConversationEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  jobPost      JobPost?      @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  seekerPost   SeekerPost?   @relation(fields: [seekerPostId], references: [id], onDelete: SetNull)
  messages     Message[]
  applications Application[]

  @@unique([seekerId, employerId])
  @@index([seekerId, lastMessageAt])
  @@index([employerId, lastMessageAt])
  @@map("conversations")
}

enum BoardMessageKind {
  USER
  SYSTEM // 「応募しました」「労働条件が変更されました」などのお知らせ。利用者の本文とは分ける
}

/// メッセージ。本文はアプリ側で暗号化して保存する（research R6）。運営は読めない（FR-027）
model Message {
  id             String           @id @default(uuid(7)) @db.Uuid
  conversationId String           @db.Uuid
  senderId       String?          @db.Uuid
  kind           BoardMessageKind @default(USER)
  bodyEncrypted  String?
  systemEvent    String?
  systemPayload  Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  evidence     ReportEvidence[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model Block {
  id        String   @id @default(uuid(7)) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

enum ReportTargetType {
  JOB_POST
  SEEKER_POST
  MESSAGE
  USER
}

enum ReportReason {
  ILLEGAL
  FALSE_INFO
  DISCRIMINATION
  HARASSMENT
  SPAM
  SCAM
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id             String           @id @default(uuid(7)) @db.Uuid
  reporterId     String           @db.Uuid
  targetType     ReportTargetType
  targetId       String           @db.Uuid
  reason         ReportReason
  detail         String?
  status         ReportStatus     @default(OPEN)
  receivedAt     DateTime         @default(now()) @db.Timestamptz(3)
  firstHandledAt DateTime?        @db.Timestamptz(3)
  resolvedAt     DateTime?        @db.Timestamptz(3)
  resolutionNote String?

  reporter          User               @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  evidence          ReportEvidence[]
  moderationActions ModerationAction[]

  @@index([status, receivedAt])
  @@map("reports")
}

/// 通報者が選んで提出したメッセージの複製。運営が見られるメッセージはこれだけ [法]
model ReportEvidence {
  id         String   @id @default(uuid(7)) @db.Uuid
  reportId   String   @db.Uuid
  messageId  String?  @db.Uuid
  sentAt     DateTime @db.Timestamptz(3)
  /// "REPORTER"（通報者が送ったもの）| "COUNTERPART"（相手が送ったもの）
  senderRole String
  bodyPlain  String

  report  Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@map("report_evidence")
}

enum ModerationActionType {
  REQUEST_FIX
  HIDE
  UNHIDE
  SUSPEND
  UNSUSPEND
}

model ModerationAction {
  id          String               @id @default(uuid(7)) @db.Uuid
  operatorId  String               @db.Uuid
  targetType  ReportTargetType
  targetId    String               @db.Uuid
  action      ModerationActionType
  reason      String
  fixDeadline DateTime?            @db.Timestamptz(3)
  reportId    String?              @db.Uuid
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)

  operator User    @relation(fields: [operatorId], references: [id])
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

enum InquiryCategory {
  COMPLAINT
  QUESTION
  OTHER
}

enum InquiryStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

/// お問い合わせ（苦情・相談）。受付から対応完了までの経過を残す [法]
model Inquiry {
  id             String          @id @default(uuid(7)) @db.Uuid
  userId         String?         @db.Uuid
  email          String
  category       InquiryCategory
  body           String
  status         InquiryStatus   @default(OPEN)
  receivedAt     DateTime        @default(now()) @db.Timestamptz(3)
  firstHandledAt DateTime?       @db.Timestamptz(3)
  closedAt       DateTime?       @db.Timestamptz(3)
  /// 対応の経過 [{ at, operatorId, note }]
  notes          Json            @default("[]")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@map("inquiries")
}

model SavedSearch {
  id             String    @id @default(uuid(7)) @db.Uuid
  seekerId       String    @db.Uuid
  /// { keyword?, category?, prefecture?, employmentType?, salaryMin? }
  criteria       Json
  notify         Boolean   @default(true)
  lastNotifiedAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  seeker User @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@index([seekerId])
  @@map("saved_searches")
}

enum Feature {
  AXIS_ENGINE
}

enum EntitlementSource {
  MANUAL
  SUBSCRIPTION
}

/// 追加機能の利用権（FR-041）。期限が切れても Axis の記録は消さない（原則V）
model FeatureEntitlement {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @db.Uuid
  feature     Feature
  startsAt    DateTime          @default(now()) @db.Timestamptz(3)
  endsAt      DateTime?         @db.Timestamptz(3)
  source      EntitlementSource @default(MANUAL)
  grantedById String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  user      User  @relation("EntitlementUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("EntitlementGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, feature])
  @@map("feature_entitlements")
}
